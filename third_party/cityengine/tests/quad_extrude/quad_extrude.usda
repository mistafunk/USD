#usda 1.0

def Scope "World"
{
    def Mesh "myQuad"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 2, 3, 1]
        point3f[] points = [
            (-0.5, 0.0, -0.5),
            (0.5, 0.0, -0.5),
            (-0.5, 0.0, 0.5),
            (0.5, 0.0, 0.5)]
        uniform token subdivisionScheme = "none"
    }

    def GenerativeProcedural "prtProc" (
        prepend apiSchemas = ["HydraGenerativeProceduralAPI"]
    )
    {
        token primvars:hdGp:proceduralType = "PrtProcedural"
        rel primvars:sourceMeshPath = </World/myQuad>
        asset primvars:rpkPath = @../rpks/extrude.rpk@
        float primvars:height = 1.0
    }
}



