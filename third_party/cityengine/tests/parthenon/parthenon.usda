#usda 1.0

def Scope "World"
{
    def Mesh "parthenonFootprint"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 2, 3, 1]
        point3f[] points = [
            (0.0, 0.0, 0.0),
            (69.5, 0.0, 0.0),
            (0.0, 0.0, 30.88),
            (69.5, 0.0, 30.88)]
        uniform token subdivisionScheme = "none"
    }

    def GenerativeProcedural "parthenonRule" (
        prepend apiSchemas = ["HydraGenerativeProceduralAPI"]
    )
    {
        token primvars:hdGp:proceduralType = "PrtProcedural"
        rel primvars:sourceMeshPath = </World/parthenonFootprint>
        asset primvars:rpkPath = @../rpks/parthenon.rpk@
        float primvars:Spacing = 4.29
    }
}



