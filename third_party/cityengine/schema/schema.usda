#usda 1.0
(
    """ CityEngine Schema """
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "prt"
        string libraryPath = "."
    }
) {
}

class "RuleAssignmentPrim" (
    doc = """A typed (IsA) schema prim for a CityEngine building model."""
    inherits = </Typed>
    customData = {
        string className = "RuleAssignment"
    }
)  {
    asset rulePackagePath (
        doc = """An asset path valued attribute that points to the rule package used for this building model."""
    )
    int randomSeed = 0 (
        doc = "Seed value for the pseudo random generator used by PRT for this building model."
    )
    rel initialShapes (
        doc = "geometry used as initial shapes for PRT"
    )

    # TODO: how to add rule attr overrides
}
