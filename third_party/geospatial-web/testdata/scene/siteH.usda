#usda 1.0
(
    defaultPrim = "SiteH"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteH" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/CA5_NAVD88_ftUS>
)
{
    double3 crs:position = (6806707.51, 1843929.72, 1200)
    custom string geotest:description = "T4: California zone 5 + NAVD88 heights need a geoid grid"
    custom token geotest:expect = "unsupported"

    def Mesh "Box"
    {
        float3[] extent = [(-3, -3, 0), (3, 3, 3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-3, -3, 0), (3, -3, 0), (3, 3, 0), (-3, 3, 0), (-3, -3, 3), (3, -3, 3), (3, 3, 3), (-3, 3, 3)]
        color3f[] primvars:displayColor = [(0.9, 0.85, 0.3)]
        uniform token subdivisionScheme = "none"
    }
}

