#usda 1.0
(
    defaultPrim = "SiteF"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteF" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/WGS72_Geographic3D>
)
{
    double3 crs:position = (-117.194, 34.0565, 0)
    custom string geotest:description = "T2: WGS 72 box, Helmert datum shift to WGS 84 (operation logged)"
    custom token geotest:expect = "pass"

    def Mesh "Box"
    {
        float3[] extent = [(-4, -4, 0), (4, 4, 5)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-4, -4, 0), (4, -4, 0), (4, 4, 0), (-4, 4, 0), (-4, -4, 5), (4, -4, 5), (4, 4, 5), (-4, 4, 5)]
        color3f[] primvars:displayColor = [(0.3, 0.75, 0.75)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19388943698506, 34.05649922950316, 1.9797930866479874)
            double3 xformOp:translate = (-4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19380278523718, 34.05649922950318, 1.9797930866479874)
            double3 xformOp:translate = (4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19380278520049, 34.05657135133422, 1.9797980142757297)
            double3 xformOp:translate = (4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19388943702175, 34.05657135133421, 1.9797980152070522)
            double3 xformOp:translate = (-4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19380278523438, 34.05657135127808, 6.979799112305045)
            double3 xformOp:translate = (4, 4, 5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

