#usda 1.0
(
    defaultPrim = "SiteD"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteD" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/NAD83_CA5_ftUS_2D>
)
{
    double3 crs:position = (6804980.83, 1843915.84, 0)
    custom string geotest:description = "2D CRS (California zone 5, ftUS): heights from the EGM2008 default"
    custom token geotest:expect = "pass"
    custom token geotest:expectBrowser = "unsupported"

    def Mesh "Box"
    {
        float3[] extent = [(-3, -3, 0), (3, 3, 3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-3, -3, 0), (3, -3, 0), (3, 3, 0), (-3, 3, 0), (-3, -3, 3), (3, -3, 3), (3, 3, 3), (-3, 3, 3)]
        color3f[] primvars:displayColor = [(0.5, 0.8, 0.4)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19673249048063, 34.0564729602193, -32.71053896471858)
            double3 xformOp:translate = (-3, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.196667501351, 34.056472960270305, -32.71053896471858)
            double3 xformOp:translate = (3, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19666750115675, 34.0565270519305, -32.71053896378726)
            double3 xformOp:translate = (3, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.1967324903277, 34.05652705187954, -32.71053896378726)
            double3 xformOp:translate = (-3, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19666750117203, 34.05652705191773, -29.710538961924613)
            double3 xformOp:translate = (3, 3, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

