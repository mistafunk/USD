#usda 1.0
(
    defaultPrim = "SiteG"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteG" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/NAD27_Geographic3D>
)
{
    double3 crs:position = (-117.1925, 34.0565, 0)
    custom string geotest:description = "T3: NAD27 box without NADCON grids: placed with the best equation-based operation, skipped grid operations reported"
    custom token geotest:expect = "pass"

    def Mesh "Box"
    {
        float3[] extent = [(-4, -4, 0), (4, 4, 5)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-4, -4, 0), (4, -4, 0), (4, 4, 0), (-4, 4, 0), (-4, -4, 5), (4, -4, 5), (4, 4, 5), (-4, 4, 5)]
        color3f[] primvars:displayColor = [(0.75, 0.55, 0.85)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19340741854845, 34.05647882043703, -21.178631011396646)
            double3 xformOp:translate = (-4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19332076652603, 34.05647882104615, -21.178730969317257)
            double3 xformOp:translate = (4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19332076722115, 34.056550943124435, -21.178728888742626)
            double3 xformOp:translate = (4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19340741931697, 34.056550942515315, -21.17862893268466)
            double3 xformOp:translate = (-4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19332076657842, 34.056550943084375, -16.178728888742626)
            double3 xformOp:translate = (4, 4, 5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

