{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
  "configurePresets": [
    {
      "name": "geo-base",
      "hidden": true,
      "description": "Workspace layout: this clone sits at <workspace>/src/USD.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "installDir": "${sourceDir}/../../install/${presetName}",
      "environment": {
        "CCACHE_DIR": "${sourceDir}/../../cache/ccache",
        "PATH": "${sourceDir}/../../venv/bin${pathListSep}${sourceDir}/../../venv/Scripts${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PXR_ENABLE_COMPILER_CACHE": "ON",
        "PXR_PREFER_SAFETY_OVER_SPEED": "ON",
        "PXR_FIND_TBB_IN_CONFIG": "ON",
        "PXR_BUILD_TESTS": "ON",
        "PXR_BUILD_EXAMPLES": "ON",
        "PXR_BUILD_TUTORIALS": "OFF",
        "PXR_ENABLE_MATERIALX_SUPPORT": "OFF",
        "PXR_BUILD_GEOSPATIAL_PROJ": "ON"
      }
    },
    {
      "name": "geo-native",
      "hidden": true,
      "inherits": "geo-base",
      "environment": {
        "VIRTUAL_ENV": "${sourceDir}/../../venv"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../deps/native",
        "Python3_FIND_VIRTUALENV": "ONLY",
        "PXR_ENABLE_PYTHON_SUPPORT": "ON",
        "PXR_BUILD_IMAGING": "ON",
        "PXR_BUILD_USD_IMAGING": "ON",
        "PXR_BUILD_USDVIEW": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "geo-native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "geo-native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "wasm32",
      "displayName": "WASM (wasm32, emsdk 5.0.7)",
      "description": "Mirrors build_usd.py --build-target wasm --usd-imaging: GPU-free Hydra and usdImaging, no GL.",
      "inherits": "geo-base",
      "toolchainFile": "${sourceDir}/../../emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "warnings": { "dev": false },
      "environment": {
        "EM_CACHE": "${sourceDir}/../../cache/emscripten"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/../../deps/wasm32",
        "CMAKE_FIND_ROOT_PATH": "${sourceDir}/../../deps/wasm32",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_C_FLAGS": "-pthread --use-port=zlib",
        "CMAKE_CXX_FLAGS": "-pthread --use-port=zlib",
        "CMAKE_EXE_LINKER_FLAGS": "-pthread",
        "PXR_ENABLE_PYTHON_SUPPORT": "OFF",
        "PXR_HEADLESS_TEST_MODE": "ON",
        "PXR_BUILD_USD_TOOLS": "OFF",
        "PXR_BUILD_USD_VALIDATION": "OFF",
        "PXR_BUILD_IMAGING": "ON",
        "PXR_BUILD_USD_IMAGING": "ON",
        "PXR_ENABLE_GL_SUPPORT": "OFF",
        "PXR_BUILD_USDVIEW": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "native-debug", "targets": ["install"] },
    { "name": "native-release", "configurePreset": "native-release", "targets": ["install"] },
    { "name": "wasm32", "configurePreset": "wasm32", "targets": ["install"] }
  ],
  "testPresets": [
    {
      "name": "geo-test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "flaky" } }
    },
    { "name": "native-debug", "inherits": "geo-test-base", "configurePreset": "native-debug" },
    { "name": "native-release", "inherits": "geo-test-base", "configurePreset": "native-release" },
    {
      "name": "wasm32",
      "inherits": "geo-test-base",
      "configurePreset": "wasm32",
      "description": "Excludes tests whose baselines contain size_t hashes, which differ on 32-bit (docs/WASM_GAP.md).",
      "filter": {
        "exclude": {
          "label": "flaky",
          "name": "^testUsdImagingInstanceProxyTraversal_"
        }
      }
    }
  ]
}
