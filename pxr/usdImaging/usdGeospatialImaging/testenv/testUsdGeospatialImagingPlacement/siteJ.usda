#usda 1.0
(
    defaultPrim = "SiteJ"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteJ" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/WGS84_Geographic3D>
)
{
    double3 crs:orientation = (90, 0, 0)
    double3 crs:position = (-117.1985, 34.0565, 0)
    custom string geotest:description = "T8: geographic 3D box, heading 90"
    custom token geotest:expect = "pass"

    def Mesh "Box"
    {
        float3[] extent = [(-10, -3, 0), (10, 3, 4)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-10, -3, 0), (10, -3, 0), (10, 3, 0), (-10, 3, 0), (-10, -3, 4), (10, -3, 4), (10, 3, 4), (-10, 3, 4)]
        color3f[] primvars:displayColor = [(0.4, 0.8, 0.5)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19853249444314, 34.05659015229272, 0.000008571892976760864)
            double3 xformOp:translate = (-10, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19853249437433, 34.05640984769737, 0.000008571892976760864)
            double3 xformOp:translate = (10, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19846750562569, 34.05640984769737, 0.000008571892976760864)
            double3 xformOp:translate = (10, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19846750555688, 34.056590152292706, 0.00000857282429933548)
            double3 xformOp:translate = (-10, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19846750564604, 34.05640984775411, 4.000008572824299)
            double3 xformOp:translate = (10, 3, 4)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

