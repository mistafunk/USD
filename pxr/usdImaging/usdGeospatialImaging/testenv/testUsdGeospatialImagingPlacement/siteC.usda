#usda 1.0
(
    defaultPrim = "SiteC"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteC" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/WGS84_UTM11N_3D>
)
{
    double3 crs:position = (481957.95, 3768497.85, 0)
    custom string geotest:description = "Harness self-test: control point NE has a 5 cm reference error"
    custom token geotest:expect = "fail"

    def Mesh "Box"
    {
        float3[] extent = [(-4, -4, 0), (4, 4, 4)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-4, -4, 0), (4, -4, 0), (4, 4, 0), (-4, 4, 0), (-4, -4, 4), (4, -4, 4), (4, 4, 4), (-4, 4, 4)]
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19554454145992, 34.057005048216006, 0.000002512708306312561)
            double3 xformOp:translate = (-4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19545788918938, 34.057005048216006, 0.000002512708306312561)
            double3 xformOp:translate = (4, -4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19545734757556, 34.057077170047585, 0.000002543441951274872)
            double3 xformOp:translate = (4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19554454149662, 34.05707717004778, 0.00000251084566116333)
            double3 xformOp:translate = (-4, 4, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

