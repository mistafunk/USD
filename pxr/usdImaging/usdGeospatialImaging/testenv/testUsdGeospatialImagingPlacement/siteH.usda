#usda 1.0
(
    defaultPrim = "SiteH"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteH" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/CA5_NAVD88_ftUS>
)
{
    double3 crs:position = (6806707.28, 1843929.68, 1200)
    custom string geotest:description = "T4: California zone 5 + NAVD88 heights (geoid grid)"
    custom token geotest:expect = "pass"

    def Mesh "Box"
    {
        float3[] extent = [(-3, -3, 0), (3, 3, 3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-3, -3, 0), (3, -3, 0), (3, 3, 0), (-3, 3, 0), (-3, -3, 3), (3, -3, 3), (3, 3, 3), (-3, 3, 3)]
        color3f[] primvars:displayColor = [(0.9, 0.85, 0.3)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.1910325087843, 34.05647294838429, 333.20665047876537)
            double3 xformOp:translate = (-3, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19096752337902, 34.0564729484353, 333.20665047783405)
            double3 xformOp:translate = (3, -3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19096752318455, 34.056527036976995, 333.20665047876537)
            double3 xformOp:translate = (3, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.1910325086311, 34.056527036926035, 333.20665047876537)
            double3 xformOp:translate = (-3, 3, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19096752319979, 34.05652703696423, 336.20665047783405)
            double3 xformOp:translate = (3, 3, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

