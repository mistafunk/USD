#usda 1.0
(
    defaultPrim = "SiteK"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "SiteK" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crs_library.usda@</CRS/WGS84_Geographic3D>
)
{
    double3 crs:orientation.timeSamples = {
        0: (0, 0, 0),
        10: (90, 30, 0),
    }
    double3 crs:position = (-117.19999999999999, 34.0565, 0)
    custom string geotest:description = "T8: orientation (0, 0, 0) at 0 and (90, 30, 0) at 10, slerped at 5"
    custom token geotest:expect = "pass"

    def Mesh "Box"
    {
        float3[] extent = [(-6, -2, 0), (6, 2, 3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-6, -2, 0), (6, -2, 0), (6, 2, 0), (-6, 2, 0), (-6, -2, 3), (6, -2, 3), (6, 2, 3), (-6, 2, 3)]
        color3f[] primvars:displayColor = [(0.85, 0.4, 0.6)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "ControlPoints"
    {
        def Xform "SW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.20006004650787, 34.05652534770433, -1.167012296617031)
            double3 xformOp:translate = (-6, -2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "SE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19996868343681, 34.0564493045681, 0.1378813674673438)
            double3 xformOp:translate = (6, -2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19993995354982, 34.05647465227553, 1.1670183539390564)
            double3 xformOp:translate = (6, 2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "NW"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.20003131660178, 34.0565506954257, -0.13787508476525545)
            double3 xformOp:translate = (-6, 2, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "TopNE"
        {
            custom token geotest:referenceCrs = "EPSG:4979"
            custom double3 geotest:referencePosition = (-117.19994831387127, 34.05647171131389, 4.047611835412681)
            double3 xformOp:translate = (6, 2, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

