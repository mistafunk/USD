#usda 1.0
(
    doc = """The proposal's Eiffel Tower example: a Y-up model in metres with
    its base centred at the origin, bound to the WGS 84 local tangent plane at
    the tower (origin 48.8584 N, 2.2945 E, 33 m) and turned 30 degrees
    clockwise from true north, as in the proposal's placement-order figures."""
    defaultPrim = "EiffelTower"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "EiffelTower" (
    prepend apiSchemas = ["GeospatialCRSBindingAPI"]
    prepend references = @./crsLibrary.usda@</CRS/EiffelTower_LTP>
)
{
    double3 crs:position = (0, 0, 0)
    double3 crs:orientation = (30, 0, 0)

    def Mesh "Tower"
    {
        int[] faceVertexCounts = [3, 3, 3, 3, 4]
        int[] faceVertexIndices = [0, 1, 4, 1, 2, 4, 2, 3, 4, 3, 0, 4, 0, 3, 2, 1]
        point3f[] points = [(-62.5, 0, 62.5), (62.5, 0, 62.5), (62.5, 0, -62.5), (-62.5, 0, -62.5), (0, 300, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "Unbound"
    {
        double3 xformOp:translate = (0, 57, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
