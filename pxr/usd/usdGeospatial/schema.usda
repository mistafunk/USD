#usda 1.0
(
    subLayers = [
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "usdGeospatial"
        string libraryPath = "pxr/usd/usdGeospatial"
    }
) {
}

class CoordinateReferenceSystem "CoordinateReferenceSystem" (
    inherits = </Typed>
    doc = """Geospatial Coordinate Reference System descibed by a WKT string"""
) {
    uniform token crs:wkt (
        customData = {
            string apiName = "wellKnownText"
        }
        displayName = "WKT"
        doc = """WKT doc"""
    )
}

class "BindingAPI" (
    inherits = </APISchemaBase>
    doc = """CRS bindings API doc"""
    customData = {
        token apiSchemaType = "singleApply"
        token[] apiSchemaCanOnlyApplyTo = [ "Xformable" ]
        string extraIncludes = """
#include "pxr/usd/usdGeom/xform.h"
#include "pxr/usd/usdGeospatial/coordinateReferenceSystem.h"
"""
        dictionary schemaTokens = {
            dictionary crsBinding = {
                string value = "crs:binding"
                string doc = """foobar"""
            }
        }
    }
) {
}
